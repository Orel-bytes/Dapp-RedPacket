{
  "private": true,
  "scripts": {
    "start": "umi dev",
    "build": "umi build",
    "postinstall": "umi generate tmp",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "test": "umi-test",
    "test:coverage": "umi-test --coverage"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "dependencies": {
    "@umijs/preset-react": "^1.4.19",
    "@umijs/test": "^3.1.1",
    "bignumber.js": "^9.0.0",
    "clipboard": "^2.0.6",
    "crypto-js": "^4.0.0",
    "identicon.js": "^2.3.3",
    "lint-staged": "^10.0.7",
    "prettier": "^1.19.1",
    "prop-types": "^15.7.2",
    "rc-form": "^2.4.11",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "umi": "^3.1.2",
    "web3": "1.2.7",
    "yorkie": "^2.0.0"
  }
}
